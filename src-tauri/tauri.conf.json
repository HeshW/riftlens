{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiftLens",
  "version": "0.2.0",
  "identifier": "me.legacytech.riftlens",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RiftLens",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LegacyTech",
    "shortDescription": "League of Legends stats in the LegacyTech design system"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RjRFMzczRjAyNTA3QzcKUldUSEJ5WHdjK1AwRmhINmZ0ZFMyUWU5V3dXNkt2bm16amJhZk5kWnp4cmloc01aaW92K3JSRFQK",
      "endpoints": [
        "https://github.com/HeshW/riftlens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
